{
    "name": "psc-acme/loader-product",
    "description": "Package loader-product for psc-acme organization",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Philipp Scheit",
            "email": "p.scheit@packagist.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "PscAcme\\LoaderProduct\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2",
        "nesbot/carbon": "^2.72",
        "monolog/monolog": "^3.2.0",
        "nikic/php-parser": "^5.0",
        "carbon/carbon": "^3.0",
        "laravel/framework": "^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan-symfony": "^1.0",
        "fakerphp/faker": "^1.0"
    },
    "minimum-stability": "stable",
    "config": {
        "secure-http": false
    },
    "repositories": {
        "private-packagist": {
            "type": "composer",
            "url": "http://repo.packagist.com.lo/psc-acme/"
        },
        "packagist.org": false
    }
}